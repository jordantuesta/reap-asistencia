# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase
# (Project Settings → API). La "anon key" es pública por diseño: la seguridad la dan las reglas RLS del schema.sql.
# Si no hay datos, la app funciona en "modo demostración" (todo guardado en el navegador).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica
